APP_NAME=SpeakSafe HR
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TIMEZONE=Asia/Kolkata
DEMO_MODE=true
DATABASE_URL=sqlite:///data/database/speaksafe.db
DATA_DIR=data
MAX_RECORDING_MINUTES=60
AUDIO_BITRATE_KBPS=64
TRANSCRIPTION_SEGMENT_MINUTES=10
TRANSCRIPTION_OVERLAP_SECONDS=2
LOCAL_RETENTION_HOURS=24
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_BASE_URL=https://api.assemblyai.com/v2
ASSEMBLYAI_SPEECH_MODEL=universal-3-pro
ASSEMBLYAI_LANGUAGE_DETECTION=true
ASSEMBLYAI_TRANSCRIPTION_PROMPT=Transcribe verbatim in Hindi, Marathi and English. Support Hinglish and mid-sentence language switching. Preserve the language spoken, proper names, numbers and incidents. Do not translate, summarize or rewrite the statement.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
APPS_SCRIPT_WEBHOOK_URL=
APPS_SCRIPT_SHARED_SECRET=
GOOGLE_OAUTH_CLIENT_FILE=
GOOGLE_TOKEN_FILE=data/oauth/token.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB_NAME=Employee Feedback Reports
UPLOAD_CHUNK_SIZE_MB=8
LOG_LEVEL=INFO
